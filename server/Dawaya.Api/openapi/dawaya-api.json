  "components": {
    "schemas": {
      "AccountExport": {
        "required": [
          "exportedAt",
          "account",
          "profiles"
        ],
        "type": "object",
        "properties": {
          "exportedAt": {
            "type": "string",
            "format": "date-time"
          },
          "account": {
            "$ref": "#/components/schemas/AccountExportUser"
          },
          "profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileResponse"
            }
          }
        }
      },
      "AccountExportUser": {
        "required": [
          "email",
          "createdAt",
          "preferredLanguage",
          "largeText",
          "highContrast",
          "roles"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "preferredLanguage": {
            "type": "string"
          },
          "largeText": {
            "type": "boolean"
          },
          "highContrast": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AddAllergyRequest": {
        "required": [
          "ingredientId",
          "allergyText"
        ],
        "type": "object",
        "properties": {
          "ingredientId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "allergyText": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AgeGroup": {
        "enum": [
          "Infant",
          "Child",
          "Adult",
          "Elderly",
          null
        ]
      },
      "AllergyResponse": {
        "required": [
          "id",
          "ingredientId",
          "ingredientNameEn",
          "ingredientNameAr",
          "allergyText"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ingredientId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ingredientNameEn": {
            "type": [
              "null",
              "string"
            ]
          },
          "ingredientNameAr": {
            "type": [
              "null",
              "string"
            ]
          },
          "allergyText": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AuthResponse": {
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt",
          "user"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/CurrentUserResponse"
          }
        }
      },
      "CurrentUserResponse": {
        "required": [
          "id",
          "email",
          "preferredLanguage",
          "largeText",
          "highContrast",
          "roles"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "preferredLanguage": {
            "type": "string"
          },
          "largeText": {
            "type": "boolean"
          },
          "highContrast": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DeleteAccountRequest": {
        "required": [
          "password"
        ],
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "ForgotPasswordRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status",
          "checks",
          "checkedAt"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthState"
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthState"
            }
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HealthState": {
        "enum": [
          "Healthy",
          "Degraded",
          "Unhealthy"
        ]
      },
      "IngredientResponse": {
        "required": [
          "id",
          "nameEn",
          "nameAr"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
