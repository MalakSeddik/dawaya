{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "dawaya-api",
    "Audience": "dawaya-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "App": {
    "WebBaseUrl": ""
  },
  "Storage": {
    "LocalRoot": "App_Data/blobs"
  }
}
